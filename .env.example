TELEGRAM_BOT_TOKEN=           # From @BotFather
TELEGRAM_ALLOWED_USER_ID=     # Your Telegram user ID (send /start to @userinfobot)

OPENAI_API_KEY=               # Whisper transcription
JINA_API_KEY=                 # Optional — higher rate limits for URL fetching (https://jina.ai)

OBSIDIAN_VAULT_PATH=          # Absolute path, e.g. /Users/you/Documents/MyVault
OBSIDIAN_RESOURCE_FOLDER=     # Subfolder, e.g. Resources/Saved  (default: Resources/Saved)
SESSION_TIMEOUT_SECONDS=90    # How long to wait after last message before processing (default: 90)

# GitHub Pages deployment (optional — enables rendered HTML notes on mobile)
PAGES_REPO_PATH=              # Absolute path to local GitHub Pages repo, e.g. /Users/you/Sites/knowledge-pages
PAGES_BASE_URL=               # GitHub Pages URL, e.g. https://you.github.io/knowledge-pages
